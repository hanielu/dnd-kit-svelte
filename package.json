{
	"name": "root",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": "Haniel Ubogu <https://github.com/HanielU>",
	"type": "module",
	"workspaces": [
		"packages/*",
		"docs"
	],
	"scripts": {
		"build": "bun run --filter @dnd-kit-svelte/svelte build",
		"check": "bun run build && bun run --workspaces --if-present check",
		"dev": "bun run --workspaces --parallel --if-present dev",
		"docs": "bun run --filter docs dev",
		"format": "prettier --write .",
		"prose": "vale sync && vale docs/src/routes/docs",
		"lint": "prettier --check .",
		"release": "bun run build && changeset publish",
		"version-packages": "changeset version && bun install"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1"
	}
}
