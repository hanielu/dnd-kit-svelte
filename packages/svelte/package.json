{
	"name": "@dnd-kit-svelte/svelte",
	"version": "0.2.0",
	"description": "dnd-kit for Svelte 5: draggable, droppable and sortable primitives, a drag overlay and modifiers, built on @dnd-kit/dom with runes and attachments",
	"license": "MIT",
	"author": "Haniel Ubogu <https://github.com/HanielU>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hanielu/dnd-kit-svelte.git",
		"directory": "packages/svelte"
	},
	"homepage": "https://dnd-kit-svelte.vercel.app",
	"bugs": "https://github.com/hanielu/dnd-kit-svelte/issues",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"runes",
		"dnd",
		"dnd-kit",
		"drag-and-drop",
		"draggable",
		"droppable",
		"sortable",
		"kanban"
	],
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch",
		"build": "svelte-kit sync && svelte-package && publint",
		"prepack": "cp ../../README.md ../../LICENSE ../../NOTICE.txt . && bun run build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"NOTICE.txt",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./sortable": {
			"types": "./dist/sortable/index.d.ts",
			"svelte": "./dist/sortable/index.js"
		},
		"./modifiers": {
			"types": "./dist/modifiers/index.d.ts",
			"svelte": "./dist/modifiers/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"dependencies": {
		"@dnd-kit/abstract": "^0.5.3",
		"@dnd-kit/collision": "^0.5.3",
		"@dnd-kit/dom": "^0.5.3",
		"@dnd-kit/state": "^0.5.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	}
}
